{%- comment -%} Comportamiento compartido: aparición al hacer scroll y rieles con flechas. {%- endcomment -%}
<script>
  (function () {
    document.documentElement.classList.add('et-js');

    var RM = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    /* Titulares: palabra por palabra, saliendo de una máscara */
    function split() {
      document.querySelectorAll('.et-hero__title, .et-h2, .et-mani__title').forEach(function (el) {
        if (el.dataset.split) return; el.dataset.split = '1';
        var words = el.textContent.trim().split(/\s+/);
        el.setAttribute('aria-label', el.textContent.trim());
        el.innerHTML = words.map(function (w, i) { return '<span class="et-w" aria-hidden="true"><span style="--w:' + i + '">' + w + '</span></span>'; }).join(' ');
        el.classList.add('et-split');
        if (!el.classList.contains('et-reveal')) el.classList.add('et-reveal', 'et-reveal--bare');
      });
    }
    /* Parallax: cada capa se mueve a distinta velocidad */
    var PX = [
      ['.et-hero__media', 0.32, 1.12, false],
      ['.et-story__media img', 0.14, 1.22, true],
      ['.et-catas__media img', 0.14, 1.22, true],
      ['.et-clubband__media img', 0.28, 1.3, false],
      ['.et-mani__ghost--top', -0.35, 1, false],
      ['.et-mani__ghost--bottom', 0.3, 1, false],
      ['.et-mani__seal', -0.12, 1, false],
      ['.et-mani__bot--a', 0.18, 1, false],
      ['.et-mani__bot--b', -0.22, 1, false],
      ['.et-journal__vine', -0.15, 1, false],
      ['.et-story__cluster', -0.2, 1, false],
      ['.et-clubband__cluster', 0.2, 1, false]
    ];
    var pxItems = [], ticking = false;
    function parallax() {
      if (RM) return;
      PX.forEach(function (c) {
        document.querySelectorAll(c[0]).forEach(function (el) {
          if (el.dataset.px) return; el.dataset.px = c[1];
          if (c[3]) { var w = document.createElement('span'); w.className = 'et-px-mask'; el.parentNode.insertBefore(w, el); w.appendChild(el); }
          el.style.setProperty('--px-s', c[2]); el.classList.add('et-px');
          pxItems.push(el);
        });
      });
      update();
    }
    var hero, heroCopy, bar;
    function update() {
      ticking = false;
      var vh = window.innerHeight;
      pxItems.forEach(function (el) {
        var r = el.parentElement.getBoundingClientRect();
        if (r.bottom < -vh * 0.5 || r.top > vh * 1.5) return;
        var off = r.top + r.height / 2 - vh / 2;
        el.style.setProperty('--px', (-off * parseFloat(el.dataset.px)).toFixed(1) + 'px');
      });
      if (heroCopy) {
        var k = Math.min(Math.max(window.scrollY / (vh * 0.7), 0), 1);
        heroCopy.style.opacity = (1 - k * 1.1).toFixed(3);
        heroCopy.style.transform = 'translate3d(0,' + (k * -60).toFixed(1) + 'px,0)';
      }
      if (bar) {
        var h = document.documentElement.scrollHeight - vh;
        bar.style.transform = 'scaleX(' + (h > 0 ? window.scrollY / h : 0).toFixed(4) + ')';
      }
    }
    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
    function chrome() {
      if (!document.querySelector('.et-progress')) {
        bar = document.createElement('div'); bar.className = 'et-progress'; bar.setAttribute('aria-hidden', 'true');
        document.body.appendChild(bar);
      } else bar = document.querySelector('.et-progress');
      hero = document.querySelector('.et-hero');
      heroCopy = RM ? null : document.querySelector('.et-hero__content');
      if (hero) requestAnimationFrame(function () { hero.classList.add('is-ready'); });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    function reveal() {
      var els = document.querySelectorAll('.et-reveal:not(.is-in)');
      if (RM) { els.forEach(function (e) { e.classList.add('is-in'); }); return; }
      if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('is-in'); }); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
      els.forEach(function (e) { io.observe(e); });
    }
    function rails() {
      document.querySelectorAll('[data-et-rail]').forEach(function (wrap) {
        if (wrap.dataset.ready) return; wrap.dataset.ready = '1';
        var track = wrap.querySelector('[data-et-track]');
        var prev = wrap.querySelector('[data-et-prev]'), next = wrap.querySelector('[data-et-next]');
        if (!track) return;
        function step() { var c = track.querySelector(':scope > *'); return c ? c.getBoundingClientRect().width + 24 : 320; }
        function sync() {
          if (!prev || !next) return;
          prev.disabled = track.scrollLeft < 8;
          next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
        }
        if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
        if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
        track.addEventListener('scroll', sync, { passive: true });
        window.addEventListener('resize', sync);
        sync();
      });
    }
    function draw() {
      var bots = document.querySelectorAll('.et-bot:not(.is-drawn)');
      if (RM || !('IntersectionObserver' in window)) { bots.forEach(function (b) { b.classList.add('is-drawn'); }); return; }
      var io = new IntersectionObserver(function (en) { en.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-drawn'); io.unobserve(e.target); } }); }, { threshold: 0.2 });
      bots.forEach(function (b) { io.observe(b); });
    }
    function init() { split(); chrome(); reveal(); rails(); parallax(); draw(); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
    document.addEventListener('shopify:section:load', init);
  })();
</script>
