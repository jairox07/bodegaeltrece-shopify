{%- comment -%} Guía de maridaje: el cliente elige qué va a comer y ve los vinos que le van. Cada bloque = un platillo + sus vinos. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="et-sec et-sec--ink et-pair" id="maridaje">
  <div class="et-wrap">
    <header class="et-pair__head et-reveal">
      <p class="et-eyebrow">{{ s.eyebrow }}</p>
      <h2 class="et-h2">{{ s.title }}</h2>
      {%- render 'et-ornament' -%}
    </header>
    <div class="et-pair__tabs et-reveal" role="tablist" aria-label="Elige tu platillo">
      {%- for block in section.blocks -%}
        <button type="button" role="tab" id="et-pt-{{ block.id }}" aria-controls="et-pp-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.dish }}</button>
      {%- endfor -%}
    </div>
    {%- for block in section.blocks -%}
      <div class="et-pair__panel" role="tabpanel" id="et-pp-{{ block.id }}" aria-labelledby="et-pt-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
        {%- if block.settings.note != blank -%}<p class="et-pair__note">{{ block.settings.note }}</p>{%- endif -%}
        <ul class="et-pair__wines">
          {%- for p in block.settings.products -%}
            <li>
              <a href="{{ p.url }}">
                <span class="et-pair__img">{%- render 'et-wine-img', p: p, sizes: '160px' -%}</span>
                <span class="et-pair__name">{{ p.title }}</span>
                <span class="et-pair__price">{{ p.price | money }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>
</section>
<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    const tabs = [...root.querySelectorAll('[role=tab]')];
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((o) => { const on = o === t; o.setAttribute('aria-selected', on); root.querySelector('#' + o.getAttribute('aria-controls')).hidden = !on; });
    }));
  })();
</script>
{% stylesheet %}
  .et-pair { padding-block: clamp(64px, 9vw, 120px); }
  .et-pair__head { text-align: center; display: grid; justify-items: center; }
  .et-pair__tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: clamp(32px, 4vw, 48px) 0 clamp(28px, 4vw, 44px); }
  .et-pair__tabs button { min-height: 44px; padding: 0 20px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--et-gold) 50%, transparent); background: transparent; color: inherit; font: 500 .82rem/1 var(--et-sans); letter-spacing: .06em; cursor: pointer; transition: background-color .3s var(--et-ease), color .3s var(--et-ease); }
  .et-pair__tabs button[aria-selected=true], .et-pair__tabs button:hover { background: var(--et-gold); color: var(--et-ink); }
  .et-pair__note { text-align: center; max-width: 60ch; margin: 0 auto 28px; opacity: .8; line-height: 1.7; }
  .et-pair__panel { animation: et-pair-in .5s var(--et-ease); }
  .et-pair__wines { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(16px, 3vw, 36px); }
  .et-pair__wines a { display: grid; justify-items: center; gap: 8px; width: 160px; color: inherit; text-decoration: none; text-align: center; }
  .et-pair__img { width: 120px; height: 200px; display: grid; place-items: center; overflow: hidden; border-radius: 80px 80px 12px 12px; background: var(--et-ink-2); transition: transform .4s var(--et-ease); }
  .et-pair__img img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .et-pair__wines a:hover .et-pair__img { transform: translateY(-6px); }
  .et-pair__name { font-family: var(--et-serif); font-size: 1.1rem; }
  .et-pair__price { font-size: .8rem; letter-spacing: .1em; color: var(--et-gold); }
  @keyframes et-pair-in { from { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) { .et-pair__panel { animation: none; } }
{% endstylesheet %}
{% schema %}
{
  "name": "El Trece: maridaje",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Guía de maridaje" },
    { "type": "text", "id": "title", "label": "Título", "default": "¿Qué vas a comer hoy?" }
  ],
  "blocks": [
    { "type": "plato", "name": "Platillo", "settings": [
      { "type": "text", "id": "dish", "label": "Platillo", "default": "Carnes rojas" },
      { "type": "text", "id": "note", "label": "Nota" },
      { "type": "product_list", "id": "products", "label": "Vinos recomendados", "limit": 4 }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "El Trece: maridaje" }]
}
{% endschema %}
