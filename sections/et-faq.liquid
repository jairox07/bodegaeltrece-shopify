{%- comment -%} Preguntas frecuentes en acordeón (details/summary) con datos estructurados FAQPage. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="et-sec et-sec--paper et-faq{% if s.page_top %} et-faq--page{% endif %}" aria-labelledby="EtFaq-{{ section.id }}">
  {%- render 'et-botanic', kind: 'leaf', class: 'et-faq__leaf' -%}
  <div class="et-wrap et-faq__in">
    <header class="et-faq__head">
      <p class="et-eyebrow et-reveal">{{ s.eyebrow }}</p>
      <h2 class="et-h2" id="EtFaq-{{ section.id }}">{{ s.title }}</h2>
      {%- if s.text != blank -%}<div class="et-prose et-reveal" style="--i:2">{{ s.text }}</div>{%- endif -%}
      {%- render 'et-botanic', kind: 'cluster', class: 'et-faq__cluster' -%}
    </header>
    <div class="et-faq__list">
      {%- for block in section.blocks -%}
        <details class="et-faq__item et-reveal" style="--i:{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}{% if forloop.first and s.open_first %} open{% endif %}>
          <summary><span class="et-faq__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span><span class="et-faq__q">{{ block.settings.q }}</span><span class="et-faq__icon" aria-hidden="true"></span></summary>
          <div class="et-faq__a et-prose">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {%- for block in section.blocks -%}
  { "@type": "Question", "name": {{ block.settings.q | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.a | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
] }
</script>
{% stylesheet %}
  .et-faq--page { padding-top: clamp(140px, 16vw, 200px); }
  .et-faq__leaf { position: absolute; left: -30px; bottom: 40px; width: 200px; color: var(--et-gold); opacity: .35; transform: rotate(-24deg); }
  .et-faq__in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(36px, 6vw, 110px); align-items: start; }
  .et-faq__head { position: sticky; top: 120px; }
  .et-faq__head .et-prose { margin-top: 20px; }
  .et-faq__cluster { width: 92px; color: var(--et-gold-deep); margin-top: 36px; display: block; }
  .et-faq__item { border-top: 1px solid color-mix(in srgb, var(--et-ink) 14%, transparent); }
  .et-faq__item:last-child { border-bottom: 1px solid color-mix(in srgb, var(--et-ink) 14%, transparent); }
  .et-faq__item summary { list-style: none; display: grid; grid-template-columns: 44px 1fr 28px; align-items: baseline; gap: 12px; padding: 26px 0; cursor: pointer; }
  .et-faq__item summary::-webkit-details-marker { display: none; }
  .et-faq__n { font-family: var(--et-sans); font-size: .7rem; letter-spacing: .14em; color: var(--et-gold-deep); }
  .et-faq__q { font-family: var(--et-serif); font-size: clamp(1.15rem, 1.7vw, 1.4rem); line-height: 1.3; transition: color .3s; }
  .et-faq__item summary:hover .et-faq__q { color: var(--et-wine); }
  .et-faq__icon { position: relative; width: 16px; height: 16px; align-self: center; justify-self: end; }
  .et-faq__icon::before, .et-faq__icon::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: currentColor; transition: transform .5s var(--et-ease); }
  .et-faq__icon::after { transform: rotate(90deg); }
  .et-faq__item[open] .et-faq__icon::after { transform: rotate(0); }
  .et-faq__a { padding: 0 40px 28px 56px; opacity: .85; }
  .et-faq__item[open] .et-faq__a { animation: et-faq-in .6s var(--et-ease); }
  @keyframes et-faq-in { from { opacity: 0; translate: 0 -6px; } }
  @media (max-width: 899px) { .et-faq__in { grid-template-columns: 1fr; } .et-faq__head { position: static; } .et-faq__a { padding: 0 0 24px 56px; } }
{% endstylesheet %}
{% schema %}
{
  "name": "El Trece: preguntas",
  "settings": [
    { "type": "checkbox", "id": "page_top", "label": "Usar como página completa", "default": false },
    { "type": "checkbox", "id": "open_first", "label": "Abrir la primera", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Preguntas frecuentes" },
    { "type": "text", "id": "title", "label": "Título", "default": "Lo que nos preguntan antes de brindar." },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>¿Tienes otra duda? Escríbenos por el chat y te respondemos.</p>" }
  ],
  "blocks": [
    { "type": "q", "name": "Pregunta", "settings": [
      { "type": "text", "id": "q", "label": "Pregunta", "default": "¿Hacen envíos?" },
      { "type": "richtext", "id": "a", "label": "Respuesta", "default": "<p>Sí. Entregamos en la Zona Metropolitana de Guadalajara.</p>" }
    ] }
  ],
  "presets": [{ "name": "El Trece: preguntas", "blocks": [{ "type": "q" }] }]
}
{% endschema %}
