{%- comment -%} Franja de temporada con cuenta regresiva. Fecha y textos editables. {%- endcomment -%}
<div class="et-season" style="--et-bg: {{ section.settings.bg }}; --et-fg: {{ section.settings.fg }};">
  <div class="et-season__in page-width">
    <strong class="et-season__title">{{ section.settings.title }}</strong>
    <span class="et-season__text">{{ section.settings.text }}</span>
    {%- if section.settings.deadline != blank -%}
      <span class="et-season__count" data-deadline="{{ section.settings.deadline }}" aria-live="polite">
        <b data-days>--</b> <span>{{ section.settings.count_label }}</span>
      </span>
    {%- endif -%}
  </div>
</div>
<script>
  (function () {
    document.querySelectorAll('.et-season__count').forEach(function (c) {
      var d = new Date(c.dataset.deadline + 'T23:59:00');
      var n = Math.max(0, Math.ceil((d - new Date()) / 86400000));
      c.querySelector('[data-days]').textContent = isNaN(n) ? '--' : n;
    });
  })();
</script>
{% stylesheet %}
  .et-season { background: var(--et-bg); color: var(--et-fg); }
  .et-season__in { display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: baseline; justify-content: space-between; padding-block: 14px; }
  .et-season__title { font-family: var(--font-heading--family); font-size: 1.3rem; font-weight: 400; }
  .et-season__count b { font-variant-numeric: tabular-nums; font-size: 1.4rem; }
{% endstylesheet %}
{% schema %}
{
  "name": "El Trece: temporada",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Temporada de regalos 2026" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Pedidos corporativos con entrega antes de Navidad: cierre el 30 de noviembre." },
    { "type": "text", "id": "deadline", "label": "Fecha límite (AAAA-MM-DD)", "default": "2026-11-30" },
    { "type": "text", "id": "count_label", "label": "Texto del contador", "default": "días para el cierre" },
    { "type": "color", "id": "bg", "label": "Color de fondo", "default": "#C9A35C" },
    { "type": "color", "id": "fg", "label": "Color de texto", "default": "#0E0E0E" }
  ],
  "presets": [{ "name": "El Trece: temporada" }]
}
{% endschema %}
