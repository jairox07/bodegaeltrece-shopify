{%- comment -%}
  Botella ilustrada para productos sin foto. Usa el tipo de producto para el color del vidrio.
  Parámetros: label (nombre del vino), kind (tipo de producto).
{%- endcomment -%}
{%- assign k = kind | downcase -%}
{%- assign glass = '#2b1a17' -%}
{%- assign shine = '#5a2f2a' -%}
{%- if k contains 'blanco' -%}{%- assign glass = '#7d8a4a' -%}{%- assign shine = '#b7bf7a' -%}{%- endif -%}
{%- if k contains 'rosado' -%}{%- assign glass = '#c98b7c' -%}{%- assign shine = '#ecc0b2' -%}{%- endif -%}
{%- if k contains 'set' -%}{%- assign glass = '#1d1714' -%}{%- assign shine = '#4a3a30' -%}{%- endif -%}
<svg viewBox="0 0 120 320" role="img" aria-label="{{ label | escape }}" preserveAspectRatio="xMidYMax meet">
  <path d="M48 6h24v8h-2v58c0 10 20 24 20 52v176c0 8-6 14-14 14H44c-8 0-14-6-14-14V124c0-28 20-42 20-52V14h-2z" fill="{{ glass }}"/>
  <rect x="48" y="6" width="24" height="26" rx="2" fill="#6b1e29"/>
  <path d="M38 132c3-14 10-22 12-30v196" stroke="{{ shine }}" stroke-width="4" fill="none" stroke-linecap="round" opacity=".55"/>
  <rect x="34" y="176" width="52" height="86" fill="#ede6d6"/>
  <rect x="38" y="180" width="44" height="78" fill="none" stroke="#c9a35c" stroke-width=".8"/>
  <text x="60" y="206" text-anchor="middle" font-family="Georgia, serif" font-size="15" fill="#15110e">13</text>
  <text x="60" y="222" text-anchor="middle" font-family="Georgia, serif" font-size="6.2" letter-spacing="1.2" fill="#15110e">EL TRECE</text>
  <line x1="46" y1="230" x2="74" y2="230" stroke="#c9a35c" stroke-width=".6"/>
  <text x="60" y="243" text-anchor="middle" font-family="Georgia, serif" font-size="5.4" font-style="italic" fill="#15110e">{{ label | truncate: 18, '' | escape }}</text>
</svg>
