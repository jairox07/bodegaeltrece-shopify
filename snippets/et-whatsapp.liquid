{%- comment -%} Botón flotante de WhatsApp con mensaje precargado. {%- endcomment -%}
{%- assign wa = settings.et_whatsapp | default: '523314323987' | remove: ' ' | remove: '+' | remove: '-' -%}
{%- capture msg -%}Hola, vengo de la tienda en línea de El Trece{% if product %} y me interesa el {{ product.title }}{% endif %}. ¿Me ayudan?{%- endcapture -%}
<a class="et-wa" href="https://wa.me/{{ wa }}?text={{ msg | url_encode }}" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3.2A12.7 12.7 0 0 0 5 22.3L3.3 28.7l6.6-1.7A12.7 12.7 0 1 0 16 3.2zm0 23.2c-2 0-3.8-.5-5.4-1.5l-.4-.2-3.9 1 1-3.8-.2-.4A10.5 10.5 0 1 1 16 26.4zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.6 8.6 0 0 1-4.3-3.7c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.1-.3-.2-.6-.3z"/></svg>
  <span>¿Dudas? Escríbenos</span>
</a>
<style>
  .et-wa { position: fixed; right: clamp(14px, 2.4vw, 28px); bottom: clamp(14px, 2.4vw, 28px); z-index: 60; display: inline-flex; align-items: center; gap: 10px; height: 54px; padding: 0 14px; border-radius: 999px; background: #1f8f4e; color: #fff; text-decoration: none; font: 600 .78rem/1 var(--et-sans, sans-serif); letter-spacing: .04em; box-shadow: 0 10px 30px rgba(21,17,14,.28); transition: transform .3s var(--et-ease, ease), box-shadow .3s; }
  .et-wa svg { width: 28px; height: 28px; flex: none; }
  .et-wa span { max-width: 0; overflow: hidden; white-space: nowrap; transition: max-width .45s var(--et-ease, ease); }
  .et-wa:hover { transform: translateY(-2px); box-shadow: 0 14px 34px rgba(21,17,14,.34); }
  .et-wa:hover span, .et-wa:focus-visible span { max-width: 180px; }
  @media (prefers-reduced-motion: reduce) { .et-wa, .et-wa span { transition: none; } }
</style>
