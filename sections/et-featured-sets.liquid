{%- comment -%} Cajas destacadas: la primera va grande (caja de 6), las demás en columna. Productos elegidos en el editor. {%- endcomment -%}
<section class="et-sets page-width" style="--et-accent: {{ section.settings.accent }};">
  <header class="et-sets__head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="et-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="et-h2">{{ section.settings.title }}</h2>
    </div>
    {%- if section.settings.text != blank -%}<div class="et-sets__text">{{ section.settings.text }}</div>{%- endif -%}
  </header>
  <div class="et-sets__grid">
    {%- for product in section.settings.products limit: 3 -%}
      <article class="et-set{% if forloop.first %} et-set--feature{% endif %}">
        <a class="et-set__media" href="{{ product.url }}">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 40vw, 100vw' }}
          {%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}
        </a>
        <div class="et-set__body">
          {%- if forloop.first and section.settings.badge != blank -%}<span class="et-set__badge">{{ section.settings.badge }}</span>{%- endif -%}
          <h3 class="et-set__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
          {%- if product.description != blank -%}<p class="et-set__desc">{{ product.description | strip_html | truncatewords: 22 }}</p>{%- endif -%}
          <div class="et-set__buy">
            <span class="et-set__price">
              {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s> {% endif -%}
              {{ product.price | money }}
            </span>
            {%- form 'product', product -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="button{% unless forloop.first %} button-secondary{% endunless %}" {% unless product.available %}disabled{% endunless %}>
                {%- if product.available -%}Agregar al carrito{%- else -%}Agotado{%- endif -%}
              </button>
            {%- endform -%}
          </div>
        </div>
      </article>
    {%- else -%}
      <p class="et-empty">Elige en el editor las cajas a destacar (primero la caja de 6).</p>
    {%- endfor -%}
  </div>
</section>
{% stylesheet %}
  .et-sets { padding-block: clamp(56px, 8vw, 112px); }
  .et-sets__head { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: end; margin-bottom: 40px; }
  .et-sets__text { justify-self: end; max-width: 50ch; opacity: .8; }
  .et-sets__grid { display: grid; grid-template-columns: 1.35fr 1fr; grid-template-rows: auto auto; gap: 20px; }
  .et-set { display: grid; grid-template-columns: 140px 1fr; gap: 20px; border: 1px solid color-mix(in srgb, currentColor 14%, transparent); border-radius: 6px; padding: 20px; align-items: center; }
  .et-set--feature { grid-row: span 2; grid-template-columns: 1fr; align-content: space-between; }
  .et-set__media img, .et-set__media svg { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; border-radius: 4px; }
  .et-set__badge { display: inline-block; background: var(--et-accent); color: #0E0E0E; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; padding: 4px 10px; border-radius: 99px; margin-bottom: 10px; }
  .et-set__title { font-family: var(--font-heading--family); font-size: 1.6rem; margin: 0 0 8px; }
  .et-set--feature .et-set__title { font-size: clamp(2rem, 3vw, 2.6rem); }
  .et-set__title a { color: inherit; text-decoration: none; }
  .et-set__desc { margin: 0 0 16px; opacity: .8; }
  .et-set__buy { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }
  .et-set__price { font-variant-numeric: tabular-nums; font-size: 1.2rem; }
  .et-set__price s { opacity: .55; font-size: .9rem; }
  @media (max-width: 749px) { .et-sets__head, .et-sets__grid { grid-template-columns: 1fr; } .et-sets__text { justify-self: start; } .et-set { grid-template-columns: 1fr; } }
{% endstylesheet %}
{% schema %}
{
  "name": "El Trece: cajas",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Tienda" },
    { "type": "text", "id": "title", "label": "Título", "default": "Mejor en caja. El precio por botella baja con cada una." },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>La caja de seis es la que más rinde para regalar y para tu cava.</p>" },
    { "type": "product_list", "id": "products", "label": "Cajas (la primera se destaca)", "limit": 3 },
    { "type": "text", "id": "badge", "label": "Etiqueta de la destacada", "default": "La que más rinde" },
    { "type": "color", "id": "accent", "label": "Color de acento", "default": "#C9A35C" }
  ],
  "presets": [{ "name": "El Trece: cajas" }]
}
{% endschema %}
